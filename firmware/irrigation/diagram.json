{
  "version": 1,
  "author": "FarmTech Solutions",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp32", "top": 40, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "nitrogen", "top": -140, "left": -220, "attrs": { "color": "green", "label": "N", "key": "N" } },
    { "type": "wokwi-pushbutton", "id": "phosphorus", "top": -140, "left": -100, "attrs": { "color": "green", "label": "P", "key": "P" } },
    { "type": "wokwi-pushbutton", "id": "potassium", "top": -140, "left": 20, "attrs": { "color": "green", "label": "K", "key": "K" } },
    { "type": "wokwi-photoresistor-sensor", "id": "phSensor", "top": 40, "left": -280, "attrs": { "lux": "500" } },
    { "type": "wokwi-dht22", "id": "moistureSensor", "top": 220, "left": -250, "attrs": { "humidity": "50", "temperature": "24" } },
    { "type": "wokwi-resistor", "id": "dhtPullup", "top": 180, "left": -120, "attrs": { "value": "10000" } },
    { "type": "wokwi-relay-module", "id": "pumpRelay", "top": 30, "left": 290, "attrs": { "transistor": "npn" } },
    { "type": "wokwi-resistor", "id": "relayPulldown", "top": -20, "left": 170, "attrs": { "value": "10000" } },
    { "type": "wokwi-resistor", "id": "pumpResistor", "top": 130, "left": 390, "attrs": { "value": "330" } },
    { "type": "wokwi-led", "id": "pumpIndicator", "top": 200, "left": 400, "attrs": { "color": "blue", "label": "Bomba" } }
  ],
  "connections": [
    [ "esp32:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp32:RX0", "$serialMonitor:TX", "", [] ],
    [ "esp32:D25", "nitrogen:1.l", "green", [ "h-50", "v-170" ] ],
    [ "nitrogen:2.l", "esp32:GND.1", "black", [ "v70", "h-60" ] ],
    [ "esp32:D26", "phosphorus:1.l", "green", [ "h-40", "v-140" ] ],
    [ "phosphorus:2.l", "esp32:GND.1", "black", [ "v60", "h-40" ] ],
    [ "esp32:D27", "potassium:1.l", "green", [ "h-30", "v-110" ] ],
    [ "potassium:2.l", "esp32:GND.1", "black", [ "v50", "h-20" ] ],
    [ "esp32:3V3", "phSensor:VCC", "red", [ "h-100" ] ],
    [ "esp32:GND.1", "phSensor:GND", "black", [ "h-120" ] ],
    [ "phSensor:AO", "esp32:D34", "orange", [] ],
    [ "esp32:3V3", "moistureSensor:VCC", "red", [ "h-90", "v180" ] ],
    [ "esp32:GND.1", "moistureSensor:GND", "black", [ "h-100", "v180" ] ],
    [ "moistureSensor:SDA", "esp32:RX2", "purple", [ "v80", "h260" ] ],
    [ "dhtPullup:1", "esp32:3V3", "red", [] ],
    [ "dhtPullup:2", "moistureSensor:SDA", "purple", [] ],
    [ "esp32:VIN", "pumpRelay:VCC", "red", [ "v70", "h230" ] ],
    [ "esp32:GND.2", "pumpRelay:GND", "black", [ "h100" ] ],
    [ "esp32:D18", "pumpRelay:IN", "blue", [ "h80" ] ],
    [ "relayPulldown:1", "esp32:GND.2", "black", [ "v-30" ] ],
    [ "relayPulldown:2", "pumpRelay:IN", "blue", [] ],
    [ "esp32:3V3", "pumpRelay:NO", "red", [ "v-70", "h440" ] ],
    [ "pumpRelay:COM", "pumpResistor:1", "blue", [] ],
    [ "pumpResistor:2", "pumpIndicator:A", "blue", [] ],
    [ "pumpIndicator:C", "esp32:GND.2", "black", [ "v60", "h-230" ] ],
    [ "pumpRelay:COM", "esp32:D19", "cyan", [ "v110", "h-180" ] ]
  ],
  "serialMonitor": { "display": "always", "newline": "lf" }
}